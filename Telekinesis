local function MakeButton(
    name,
    text,
    position,
    size
)

    local Button =
        Instance.new("TextButton")

    Button.Name = name

    Button.Text = text

    Button.Size =
        size or
        UDim2.fromOffset(
            54,
            31
        )

    Button.Position =
        position

    Button.BackgroundColor3 =
        Color3.fromRGB(
            20,
            27,
            38
        )

    Button.BackgroundTransparency = 0

    Button.BorderSizePixel = 0

    Button.AutoButtonColor = false

    Button.Font =
        Enum.Font.GothamBold

    Button.TextSize = 10

    Button.TextColor3 =
        Color3.fromRGB(
            235,
            245,
            255
        )

    Button.Parent =
        Container

    local Corner =
        Instance.new("UICorner")

    Corner.CornerRadius =
        UDim.new(
            0,
            8
        )

    Corner.Parent =
        Button

    local Stroke =
        Instance.new("UIStroke")

    Stroke.Color =
        Color3.fromRGB(
            45,
            70,
            90
        )

    Stroke.Thickness = 0.8

    Stroke.Parent =
        Button

    -- Hiệu ứng nhấn
    Button.MouseButton1Down:Connect(function()

        Button.BackgroundColor3 =
            Color3.fromRGB(
                0,
                145,
                190
            )

        Stroke.Color =
            Color3.fromRGB(
                0,
                225,
                255
            )

    end)

    Button.MouseButton1Up:Connect(function()

        Button.BackgroundColor3 =
            Color3.fromRGB(
                20,
                27,
                38
            )

        Stroke.Color =
            Color3.fromRGB(
                45,
                70,
                90
            )

    end)

    return Button

end

