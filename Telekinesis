--==============================================================
-- TARGET
--==============================================================

local function GetTarget(mouse)

    if not mouse then
        return nil
    end

    local Target =
        mouse.Target

    if not Target then
        return nil
    end

    if not Target:IsA(
        "BasePart"
    ) then
        return nil
    end

    if Target.Anchored then
        return nil
    end

    local Character =
        LocalPlayer.Character

    if Character and
        Target:IsDescendantOf(
            Character
        ) then

        return nil

    end

    return Target

end

--==============================================================
-- LASER
--==============================================================

local function CreateLaser(
    fromPart,
    toPart
)

    if not fromPart
        or not toPart then

        return nil

    end

    local Laser =
        Instance.new("Part")

    Laser.Name =
        "TelekinesisLaser"

    Laser.Anchored = true

    Laser.CanCollide = false
    Laser.CanTouch = false
    Laser.CanQuery = false

    Laser.Material =
        Enum.Material.Neon

    Laser.Color =
        Color3.fromRGB(
            0,
            200,
            255
        )

    Laser.Transparency = 0.25

    local Start =
        fromPart.Position

    local Finish =
        toPart.Position

    local Distance =
        (Start - Finish).Magnitude

    Laser.Size =
        Vector3.new(
            0.18,
            0.18,
            Distance
        )

    Laser.CFrame =
        CFrame.lookAt(
            (Start + Finish) / 2,
            Finish
        )

    Laser.Parent =
        workspace

    return Laser

end

--==============================================================
-- TELEKINESIS
--==============================================================

local function StartTelekinesis(mouse)

    if mousedown then
        return
    end

    if uneq then
        return
    end

    mousedown = true

    local Character =
        LocalPlayer.Character

    if not Character then

        mousedown = false

        return

    end

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid then

        mousedown = false

        return

    end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then

        mousedown = false

        return

    end

    local Target =
        GetTarget(mouse)

    if not Target then

        mousedown = false

        return

    end

    object = Target

    dist =
        (
            object.Position
            - Handle.Position
        ).Magnitude

    offset =
        Vector3.zero

    point.Parent =
        Tool

    local laser = nil

    local connection

    connection =
        RunService.RenderStepped:Connect(
            function()

                if not mousedown then
                    return
                end

                if uneq then

                    mousedown = false

                    return

                end

                if not object then

                    mousedown = false

                    return

                end

                if not object.Parent then

                    mousedown = false

                    return

                end

                if not Handle.Parent then

                    mousedown = false

                    return

                end

                --==================================================
                -- DI CHUYỂN
                --==================================================

                if moveDir.FWD then

                    offset +=
                        Vector3.new(
                            0,
                            0,
                            -moveStep
                        )

                end

                if moveDir.BCK then

                    offset +=
                        Vector3.new(
                            0,
                            0,
                            moveStep
                        )

                end

                if moveDir.LFT then

                    offset +=
                        Vector3.new(
                            -moveStep,
                            0,
                            0
                        )

                end

                if moveDir.RGT then

                    offset +=
                        Vector3.new(
                            moveStep,
                            0,
                            0
                        )

                end

                if moveDir.UP then

                    offset +=
                        Vector3.new(
                            0,
                            moveStep,
                            0
                        )

                end

                if moveDir.DN then

                    offset +=
                        Vector3.new(
                            0,
                            -moveStep,
                            0
                        )

                end

                --==================================================
                -- CAMERA
                --==================================================

                local Camera =
                    workspace.CurrentCamera

                if not Camera then
                    return
                end

                local CameraCF =
                    Camera.CFrame

                local BasePosition =
                    Handle.Position
                    + CameraCF.LookVector
                    * dist

                local TargetPosition =
                    BasePosition
                    + CameraCF.RightVector
                    * offset.X
                    + CameraCF.UpVector
                    * offset.Y
                    + CameraCF.LookVector
                    * (-offset.Z)

                --==================================================
                -- BODY POSITION
                --==================================================

                BP.Parent =
                    object

                BP.Position =
                    TargetPosition

                --==================================================
                -- LASER
                --==================================================

                if laser then

                    laser:Destroy()

                    laser = nil

                end

                laser =
                    CreateLaser(
                        Handle,
                        object
                    )

            end
        )

    --==========================================================
    -- CHỜ THẢ
    --==========================================================

    repeat

        task.wait()

    until not mousedown

    --==========================================================
    -- CLEAN
    --==========================================================

    if connection then

        connection:Disconnect()

    end

    if laser then

        laser:Destroy()

    end

    BP.Parent = nil

    object = nil

    point.Parent = nil

end

--==============================================================
-- EQUIP
--==============================================================

local mouse = nil

Tool.Equipped:Connect(
    function(toolMouse)

        uneq = false

        mouse =
            toolMouse

        -- HIỆN UI
        Container.Visible = true

        local Character =
            LocalPlayer.Character

        if Character then

            local Humanoid =
                Character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if Humanoid then

                Humanoid.Died:Connect(
                    function()

                        mousedown = false

                        uneq = true

                        BP.Parent = nil

                        point.Parent = nil

                        Container.Visible = false

                    end
                )

            end

        end

        --======================================================
        -- CLICK VẬT
        --======================================================

        mouse.Button1Down:Connect(
            function()

                StartTelekinesis(
                    mouse
                )

            end
        )

        --======================================================
        -- PHÍM R
        --======================================================

        mouse.KeyDown:Connect(
            function(key)

                key =
                    key:lower()

                if key == "r" then

                    if not object then
                        return
                    end

                    local BG =
                        Instance.new(
                            "BodyGyro"
                        )

                    BG.MaxTorque =
                        Vector3.new(
                            math.huge,
                            math.huge,
                            math.huge
                        )

                    BG.CFrame =
                        CFrame.new(
                            object.Position
                        )

                    BG.Parent =
                        object

                    task.wait(
                        0.15
                    )

                    if BG and BG.Parent then

                        BG:Destroy()

                    end

                    if object
                        and object.Parent then

                        object.AssemblyLinearVelocity =
                            Vector3.zero

                        object.AssemblyAngularVelocity =
                            Vector3.zero

                    end

                end

            end
        )

        Tool.Icon =
            "rbxasset://textures/GunCursor.png"

    end
)

